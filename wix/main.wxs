<?xml version='1.0' encoding='windows-1252'?>
<!--
  WiX Toolset (v3) source for the Corvo MSI installer.
  Built directly with candle.exe/light.exe from
  .github/workflows/release.yml - no cargo-wix dependency required.

  Installs PER-USER (InstallScope='perUser') under %LOCALAPPDATA%\Programs\Corvo:
  no admin/UAC prompt needed to install or update. Gets a Start Menu shortcut
  and shows up in Settings > Apps / Control Panel > Programs and Features.

  Variables passed in via candle -d:
    Version : the app version (e.g. 0.1.0)
    BinDir  : path to directory containing built corvo.exe
-->
<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>

  <Product
      Id='*'
      Name='Corvo'
      UpgradeCode='A181CA24-8FDA-467B-8FA6-35628A7280DC'
      Manufacturer='Diego Letelier'
      Language='1033'
      Codepage='1252'
      Version='$(var.Version)'>

    <Package
        Id='*'
        Keywords='Installer'
        Description='Corvo $(var.Version) Installer'
        Manufacturer='Diego Letelier'
        InstallerVersion='500'
        Languages='1033'
        Compressed='yes'
        InstallScope='perUser'
        SummaryCodepage='1252'/>

    <MajorUpgrade
        Schedule='afterInstallInitialize'
        DowngradeErrorMessage='A newer version of [ProductName] is already installed. Setup will now exit.'/>

    <Media Id='1' Cabinet='media1.cab' EmbedCab='yes' DiskPrompt='CD-ROM #1'/>
    <Property Id='DiskPrompt' Value='Corvo Installation [1]'/>

    <Property Id='WIXUI_INSTALLDIR' Value='APPLICATIONFOLDER'/>
    <Property Id='ARPHELPLINK' Value='https://github.com/diegoleteliers10/corvo'/>
    <Property Id='ARPURLINFOABOUT' Value='https://github.com/diegoleteliers10/corvo'/>
    <Property Id='ARPNOREPAIR' Value='1' Secure='yes'/>

    <!-- Per-user install root: %LOCALAPPDATA%\Programs\Corvo -->
    <Directory Id='TARGETDIR' Name='SourceDir'>
      <Directory Id='LocalAppDataFolder'>
        <Directory Id='ProgramsFolder' Name='Programs'>
          <Directory Id='APPLICATIONFOLDER' Name='Corvo'>

            <Component Id='License' Guid='AB0DA30A-51DC-4FE1-8F1A-65A2D8706FBE'>
              <File Id='LicenseFile' Source='wix\License.rtf' KeyPath='no'/>
              <RegistryValue
                  Root='HKCU'
                  Key='Software\Corvo'
                  Name='LicenseInstalled'
                  Type='integer'
                  Value='1'
                  KeyPath='yes'/>
            </Component>

            <Component Id='binary0' Guid='6DB03FBB-BD1F-4D5B-AED5-34A4738A292C'>
              <File
                  Id='exe0'
                  Name='corvo.exe'
                  Source='$(var.BinDir)\corvo.exe'
                  KeyPath='no'/>
              <RegistryValue
                  Root='HKCU'
                  Key='Software\Corvo'
                  Name='BinaryInstalled'
                  Type='integer'
                  Value='1'
                  KeyPath='yes'/>
              <RemoveFolder Id='RemoveApplicationFolder' Directory='APPLICATIONFOLDER' On='uninstall'/>
              <RemoveFolder Id='RemoveProgramsFolder' Directory='ProgramsFolder' On='uninstall'/>
            </Component>

          </Directory>
        </Directory>
      </Directory>

      <!-- Start Menu shortcut -->
      <Directory Id='ProgramMenuFolder'>
        <Directory Id='ApplicationProgramsFolder' Name='Corvo'>
          <Component Id='ApplicationShortcut' Guid='*'>
            <Shortcut
                Id='ApplicationStartMenuShortcut'
                Name='Corvo'
                Description='Lightweight native application launcher'
                Target='[#exe0]'
                WorkingDirectory='APPLICATIONFOLDER'
                Icon='ProductICO'/>
            <RemoveFolder Id='ApplicationProgramsFolder' On='uninstall'/>
            <RegistryValue
                Root='HKCU'
                Key='Software\Corvo'
                Name='installed'
                Type='integer'
                Value='1'
                KeyPath='yes'/>
          </Component>
        </Directory>
      </Directory>
    </Directory>

    <Feature
        Id='MainApplication'
        Title='Corvo'
        Description='Installs the Corvo launcher binary, Start Menu shortcut, and license.'
        Level='1'
        ConfigurableDirectory='APPLICATIONFOLDER'
        AllowAdvertise='no'
        Display='expand'
        Absent='disallow'>
      <ComponentRef Id='License'/>
      <ComponentRef Id='binary0'/>
      <ComponentRef Id='ApplicationShortcut'/>
    </Feature>

    <SetProperty Id='ARPINSTALLLOCATION' Value='[APPLICATIONFOLDER]' After='CostFinalize'/>
    <Icon Id='ProductICO' SourceFile='assets\corvoIcon.ico'/>
    <Property Id='ARPPRODUCTICON' Value='ProductICO'/>

    <UI>
      <UIRef Id='WixUI_InstallDir'/>
    </UI>

    <WixVariable Id='WixUILicenseRtf' Value='wix\License.rtf'/>

  </Product>
</Wix>
